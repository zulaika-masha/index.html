{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cyber Guard: Start Flask Server",
            "type": "shell",
            "command": "python app.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Cyber Guard: Run Unit Tests",
            "type": "shell",
            "command": "python -m unittest discover -s tests -v",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
