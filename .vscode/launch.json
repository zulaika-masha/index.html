{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cyber Guard: Flask App",
            "type": "debugpy",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true,
            "autoReload": {
                "enable": true
            }
        }
    ]
}
